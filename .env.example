# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Environment Variables — copy to ~/.sentinel/.env and fill in values.
# Any variable set in the shell environment takes priority over values here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sentinel home directory ──────────────────────────────────────────────────
# Override to relocate the entire ~/.sentinel workspace.
# SENTINEL_HOME=~/.sentinel

# ── Ollama model storage (Section 2) ────────────────────────────────────────
# All models pulled by Sentinel are stored here, isolated from the system
# default (~/.ollama).  Override only if you want to share a model store
# with other tools.
# OLLAMA_MODELS=~/.sentinel/.ollama/models

# ── Operating mode (Section 6A) ─────────────────────────────────────────────
# Set automatically at runtime by the connectivity check + user prompt.
# Pre-set here to skip the interactive prompt on every launch.
#   offline — all inference runs locally via Ollama (default, no API keys needed)
#   online  — tasks are routed to the best available cloud model
# SENTINEL_MODE=offline

# ── Ollama Cloud API key (mandatory for online mode) ─────────────────────────
# Generate at: https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# ── External provider fallback keys (optional) ──────────────────────────────
# Used when Ollama Cloud has no suitable model for a given task.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ── Model overrides for external providers (optional) ────────────────────────
# SENTINEL_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# SENTINEL_OPENAI_MODEL=gpt-4o
# SENTINEL_GOOGLE_MODEL=gemini-2.0-flash

# ── Ollama local daemon ───────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434

# ── Embedding model ──────────────────────────────────────────────────────────
# SENTINEL_EMBEDDING_MODEL=nomic-embed-text

# ── Context budget ───────────────────────────────────────────────────────────
# SENTINEL_TOKEN_BUDGET=3000
